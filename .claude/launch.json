{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "animalia-backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8001", "--app-dir", "animalia-backend", "--reload-dir", "animalia-backend", "--env-file", "animalia-backend/.env"],
      "port": 8001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "animalia-frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "frontend-3000",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "animalia-frontend", "run", "dev", "--", "--port", "3000", "--strictPort"],
      "port": 3000
    }
  ]
}
