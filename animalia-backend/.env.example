# Application
APP_NAME=tree-of-life-backend
APP_ENV=development
DEBUG=true

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg2://tol:tol@localhost:5432/treeoflife

# API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# External APIs (leave blank until you have keys)
GBIF_USER=
GBIF_PASSWORD=
IUCN_API_TOKEN=
OPENTREE_API_BASE=https://api.opentreeoflife.org/v3

# ETL
DATA_DIR=./data
COL_DATASET_VERSION=
GBIF_DATASET_VERSION=
OPENTREE_SYNTHESIS_VERSION=
